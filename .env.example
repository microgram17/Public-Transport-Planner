# Host ports. Change these if either port is already in use.
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# PostgreSQL credentials used by the Docker PostgreSQL service.
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=databasename

# The backend reaches PostgreSQL by its Compose service name.
DATABASE_URL=postgresql+asyncpg://username:password@postgres:5432/databasename

# URL used by the browser to reach the backend.
VITE_API_URL=http://localhost:8000
