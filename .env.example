# Host ports used during local development.
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# Local PostgreSQL container.
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=databasename

# PostgreSQL connection used by the backend.
#
# For the local Compose database:
DATABASE_URL=postgresql://username:password@postgres:5432/databasename
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT=30

# Trafiklab GTFS Regional.
GTFS_OPERATOR=sl
GTFS_REGIONAL_STATIC_API_KEY=
GTFS_REGIONAL_REALTIME_API_KEY=
GTFS_CACHE_DIR=/var/lib/gtfs
GTFS_VALIDATE=true

# For an external database, replace "postgres" with its hostname or IP.
# DATABASE_URL=postgresql://username:password@192.168.1.100:5432/databasename
